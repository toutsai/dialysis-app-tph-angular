{
  "name": "dialysis-local-server",
  "version": "1.0.0",
  "description": "本地透析排程系統後端伺服器",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "init-db": "node src/db/init.js",
    "migrate": "node migrations/migrate.js",
    "backup": "node src/utils/backup.js",
    "import-firebase": "node scripts/firebase-to-sqlite.js",
    "build:angular": "cd angular-client && npm run build",
    "install:angular": "cd angular-client && npm install",
    "dev:angular": "cd angular-client && npx ng serve --configuration development --port 5173",
    "smoke:tph-angular": "node scripts/smoke-test-tph-angular.cjs",
    "test": "node scripts/run-regression-tests.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "start:review": "node scripts/start-review-dev.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "node-cron": "^4.2.1",
    "uuid": "^11.1.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "nodemon": "^3.0.3"
  },
  "overrides": {
    "express": {
      "qs": "6.16.0"
    }
  }
}
